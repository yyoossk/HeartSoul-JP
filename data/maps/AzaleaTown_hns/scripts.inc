AzaleaTown_EventScript_GSBall::
	lock
	applymovement OBJ_EVENT_ID_PLAYER, AzaleaTown_Movement_PlayerGSBall
	waitmovement 0
	clearflag FLAG_HIDE_AZALEA_TOWN_KURT
	addobject LOCALID_AZALEA_TOWN_KURT_GS
	opendoor 19, 11
	waitdooranim
	waitmovement 0
	closedoor 19, 11
	waitdooranim
	applymovement LOCALID_AZALEA_TOWN_KURT_GS, AzaleaTown_Movement_Kurt2
	playse SE_M_PETAL_DANCE
	waitmovement 0
	msgbox AzaleaTown_Text_Kurt1, MSGBOX_DEFAULT
	closemessage
	playse SE_M_PETAL_DANCE
	msgbox AzaleaTown_Text_Kurt2, MSGBOX_DEFAULT
	giveitem ITEM_GS_BALL
	waitse
	playse SE_M_PETAL_DANCE
	turnobject LOCALID_AZALEA_TOWN_KURT_GS, DIR_WEST
	turnobject OBJ_EVENT_ID_PLAYER, DIR_WEST
	playse SE_M_PETAL_DANCE
	waitse
	turnobject LOCALID_AZALEA_TOWN_KURT_GS, DIR_SOUTH
	turnobject OBJ_EVENT_ID_PLAYER, DIR_NORTH
	msgbox AzaleaTown_Text_Kurt3, MSGBOX_DEFAULT
	closemessage
	applymovement LOCALID_AZALEA_TOWN_KURT_GS, AzaleaTown_Movement_KurtLeave
	delay 60
	opendoor 19, 11
	waitdooranim
	waitmovement 0
	setflag FLAG_HIDE_AZALEA_TOWN_KURT
	removeobject LOCALID_AZALEA_TOWN_KURT_GS
	closedoor 19, 11
	waitdooranim
	setvar VAR_AZALEA_TOWN_STATE, 9
	release
	end

AzaleaTown_Movement_Silver_EnterTop:
	walk_fast_left
	walk_fast_left
	walk_fast_left
	walk_fast_left
	walk_fast_left
	walk_fast_left
	walk_fast_left
	step_end

AzaleaTown_Movement_Silver_EnterBot:
	walk_fast_down
	walk_fast_left
	walk_fast_left
	walk_fast_left
	walk_fast_left
	walk_fast_left
	walk_fast_left
	walk_fast_left
	step_end

AzaleaTown_Movement_Silver_LeaveTop:
	walk_fast_left
	walk_fast_left
	walk_fast_left
	walk_fast_left
	step_end

AzaleaTown_Movement_Silver_LeaveBot:
	walk_fast_left
	walk_fast_left
	walk_fast_left
	walk_fast_up
	walk_fast_left
	step_end

AzaleaTown_Movement_Player_LeaveTop:
	lock_facing_direction
	walk_fast_down
	unlock_facing_direction
	face_up
	step_end

AzaleaTown_Movement_Player_LeaveBot:
	lock_facing_direction
	walk_fast_up
	unlock_facing_direction
	face_down
	step_end

AzaleaTown_Movement_Kurt1:
	walk_down
	step_end

AzaleaTown_Movement_Kurt2:
	walk_down
	walk_down
	walk_down
	face_right
	delay_8
	face_left
	delay_8
	face_down
	step_end

AzaleaTown_Movement_PlayerGSBall:
	walk_down
	walk_down
	walk_down
	face_left
	delay_16
	face_right
	delay_8
	face_up
	step_end

AzaleaTown_Movement_KurtLeave:
	walk_up
	walk_up
	walk_up
	step_end

AzaleaTown_Text_RivalBefore:
	.string "‥ひとつ　きくぞ\pロケットだんが　ふっかつしたって\nほんとうか？\pなに？　おまえが　たおした？\nふん　うそを　つくな\pじょうだんじゃ　ないって？\nだったら　うでまえを　みせてみろ$"

AzaleaTown_Text_RivalWin:
	.string "‥ふん！　つかえない　ポケモンだ！\pいいか　おまえが　かったのは\nおれの　ポケモンが　よわかった\lからだ$"

AzaleaTown_Text_RivalAfter:
	.string "おれは　よわい　やつが　きらいだ\pポケモンも　トレーナーも\nだれだろうと　かんけいない\pおれは　つよくなって\nよわい　やつを　ぶっつぶす\pロケットだんも　おなじだ\pやつらは　むれると\nえらそうに　する\pだが　ひとりに　なれば　よわい\nおれは　やつらが　だいきらいだ\pおまえも　じゃまするな\nおまえみたいな　よわい　やつは\lめざわりなだけだ$"

AzaleaTown_Text_RivalLoss:
	.string "‥ふん！　やっぱり　うそだったな$"

AzaleaTown_Text_Rocket1:
	.string "なかは　あぶないから\nおれが　みはりを　してるのさ\pおれって　しんせつだろ？$"

AzaleaTown_Text_Rocket2:
	.string "ヤドンのシッポって　しってるか？\nうまいらしいぜ！\pいい　こと　きいたろ？$"

AzaleaTown_Text_GrampsBefore:
	.string "まちから　ヤドンが\nいなくなって　しまった‥\pどこかで　シッポが\nうられて　おるらしい$"

AzaleaTown_Text_GrampsAfter:
	.string "ヤドンたちが　もどってきた\pあいつらの　ことじゃ\nどこかで　ぼんやり　して\lおっただけ　かもしれんな$"

AzaleaTown_Text_Teacher:
	.string "ガンテツさんに　ボールを\nつくって　もらいに　きたの？\pそういう　ひと　おおいのよ$"

AzaleaTown_Text_Youngster:
	.string "ヒワダを　ぬけると\nウバメのもりだよ\pでも　ほそい　きが　じゃまで\nとおれないんだ\pすみやきの　おじさんの\nポケモンなら　きを　きれるよ$"

AzaleaTown_Text_Slowpoke1:
	.string "ヤドン『‥‥‥‥‥‥‥\p‥‥‥‥‥‥‥‥‥‥‥‥‥‥‥あくび？$"

AzaleaTown_Text_Kurt1:
	.string "ウバメのもりが　ざわめいとる！\pいったい　なにが\nおきとるんじゃ？$"

AzaleaTown_Text_Kurt2:
	.string "{PLAYER}！\nGSボールを　かえすぞ！$"

AzaleaTown_Text_Kurt3:
	.string "ウバメのもりが　なぜ\nざわめいとるのか\lみてきて　くれんか？$"

AzaleaTown_Text_Sign:
	.string "ヒワダタウン\nひとと　ポケモンが\lなかよく　くらす　まち$"

AzaleaTown_Text_KurtsHouseSign:
	.string "ガンテツの　いえ$"

AzaleaTown_Text_GymSign:
	.string "ヒワダタウン\nポケモンジム\pジムリーダー　ツクシ\pあるく　むしポケモン\nだいひゃっか$"

AzaleaTown_Text_SlowpokeWellSign:
	.string "ヤドンのいど\pべつめい　あまごいの　いど\pヤドンの　あくびで　あめが\nふると　しんじられている\p400ねん　まえ　ヤドンの\nあくびで　ひでりが　おわったと\lきろくに　のこっている$"

AzaleaTown_Text_CharcoalKilnSign:
	.string "すみやきごや$"

AzaleaTown_Text_IlexForestSign:
	.string "ウバメのもり\pゲートから　おはいりください$"
